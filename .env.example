# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Redis pub/sub used by the market data engine and WebSocket relay.
REDIS_SERVERB="redis://localhost:6380"

# Browser URL for the market data WebSocket server.
NEXT_PUBLIC_MARKET_WS_URL="ws://localhost:5000"

# Optional simulated liquidity markets: SYMBOL:REFERENCE_PRICE:TICK_SIZE, comma-separated.
MARKET_MAKER_SYMBOLS="BTCUSDT:67000:0.1,ETHUSDT:2470:0.01,SOLUSDT:162:0.01"
MARKET_MAKER_ORDERS_PER_SIDE="10000"
MARKET_MAKER_MIN_SPREAD_TICKS="1"
MARKET_MAKER_QUOTE_SCALE_BPS="10"
MARKET_MAKER_MIN_ORDER_NOTIONAL="100"
MARKET_MAKER_MAX_ORDER_NOTIONAL="2000"
MARKET_MAKER_MIN_TRADE_NOTIONAL="5000"
MARKET_MAKER_MAX_TRADE_NOTIONAL="30000"
MARKET_MAKER_REPRICE_INTERVAL_MS="10000"
MARKET_MAKER_REPRICE_FRACTION="0.01"
MARKET_MAKER_TRADE_INTERVAL_MS="250"
