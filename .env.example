# Copy this file to the repository-root `.env` and replace the placeholder with your real connection string.
# Both `apps/web` and `apps/database-processor` load the shared database URL from here.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
# If your provider requires a CA certificate, place it at `certs/ca.pem` and
# add `sslrootcert=../../certs/ca.pem` to the connection string query parameters.

# Required in production. Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Redis pub/sub used by the market data engine and WebSocket relay.
REDIS_SERVERB="redis://localhost:6380"

# Redis queue used by the engine trade producer and trade-history database processor.
REDIS_SERVERC="redis://localhost:6381"

# Browser URL for the market data WebSocket server.
NEXT_PUBLIC_MARKET_WS_URL="ws://localhost:5000"

# Optional simulated liquidity markets: BASE/QUOTE:REFERENCE_PRICE:TICK_SIZE, comma-separated.
MARKET_MAKER_SYMBOLS="BTC/USDT:67000:0.1,ETH/USDT:2470:0.01,SOL/USDT:162:0.01"
MARKET_MAKER_ORDERS_PER_SIDE="10000"
MARKET_MAKER_FLOW_SOURCE="binance"
MARKET_MAKER_MIN_SPREAD_TICKS="1"
MARKET_MAKER_QUOTE_SCALE_BPS="10"
MARKET_MAKER_MIN_ORDER_NOTIONAL="100"
MARKET_MAKER_MAX_ORDER_NOTIONAL="2000"
MARKET_MAKER_MIN_TRADE_NOTIONAL="5000"
MARKET_MAKER_MAX_TRADE_NOTIONAL="30000"
MARKET_MAKER_REPRICE_INTERVAL_MS="2000"
MARKET_MAKER_REPRICE_FRACTION="0.05"
MARKET_MAKER_TRADE_INTERVAL_MS="250"
