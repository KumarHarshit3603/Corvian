{
  "name": "corvian",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "contract:emit": "prisma contract emit"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.7.0",
    "@types/node": "^26.6.5",
    "prettier": "3.9.6",
    "prisma": "^8.0.0-rc.23",
    "turbo": "^2.11.8",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.11.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@prisma/orm-postgres": "^8.0.0-rc.18",
    "dotenv": "^18.0.8"
  }
